          "depends_on": null,
          "script_name": "test_order_detail_after_click.py",
          "script_content": "# generated by aitest\nimport os\nfrom playwright.sync_api import sync_playwright\n\nBASE_URL = os.environ.get(\"TARGET_URL\", \"http://127.0.0.1:5098/\")\n\n\ndef main():\n    os.makedirs(\"test-results\", exist_ok=True)\n    with sync_playwright() as p:\n        browser = p.chromium.launch()\n        page = browser.new_page()\n        page.goto(BASE_URL, wait_until=\"networkidle\")\n        detail = page.get_by_text(\"查看详情\").first\n        assert detail.count() > 0, \"首页未找到“查看详情”入口\"\n        detail.click()\n        page.wait_for_load_state(\"networkidle\")\n        page.screenshot(path=\"test-results/order_detail_after_click.png\")\n        body_text = page.inner_text(\"body\")\n        assert \"订单详情\" in body_text, f\"点击查看详情后未显示订单详情，页面内容: {body_text[:200]}\"\n        browser.close()\n    print(\"PASS: 点击查看详情后显示订单详情\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
        }
