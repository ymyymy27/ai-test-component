          "script_name": "test_home_order_list_title.py",
          "script_content": "# generated by aitest\nimport os\nfrom playwright.sync_api import sync_playwright\n\nBASE_URL = os.environ.get(\"TARGET_URL\", \"http://127.0.0.1:5098/\")\n\n\ndef main():\n    os.makedirs(\"test-results\", exist_ok=True)\n    with sync_playwright() as p:\n        browser = p.chromium.launch()\n        page = browser.new_page()\n        page.goto(BASE_URL, wait_until=\"networkidle\")\n        page.screenshot(path=\"test-results/home_order_list_title.png\")\n        body_text = page.inner_text(\"body\")\n        assert \"订单列表\" in body_text, f\"首页未显示订单列表标题，页面内容: {body_text[:200]}\"\n        browser.close()\n    print(\"PASS: 首页显示订单列表标题\")\n\n\nif __name__ == \"__main__\":\n    main()\n"
        },
