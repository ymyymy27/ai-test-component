{
  "openapi": "3.0.3",
  "info": { "title": "Generic Catalog API", "version": "1.0.0" },
  "paths": {
    "/api/books": {
      "get": {
        "responses": { "200": { "description": "ok" } }
      },
      "post": {
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "title": { "type": "string" },
                  "isbn": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/api/books/{id}": {
      "get": { "responses": { "200": { "description": "ok" } } },
      "delete": {
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "deleted" } }
      }
    }
  }
}
