{
  "name": "aitest-trae",
  "displayName": "AI Test — Trae 轻量扩展",
  "description": "调用本地 aitest CLI 的轻量 Trae 面板；无常驻核心、无命名管道。",
  "version": "0.5.0",
  "publisher": "aitest-local",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:aitest.openPanel",
    "onCommand:aitest.checkEnvironment",
    "onCommand:aitest.runStatus",
    "onView:aitest.sidebar"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aitest-container",
          "title": "AI 测试",
          "icon": "media/testing.svg"
        }
      ]
    },
    "views": {
      "aitest-container": [
        {
          "id": "aitest.sidebar",
          "name": "AI 测试",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "aitest.openPanel",
        "title": "AI Test: 打开测试面板"
      },
      {
        "command": "aitest.checkEnvironment",
        "title": "AI Test: 检查环境"
      },
      {
        "command": "aitest.runStatus",
        "title": "AI Test: 查看运行状态"
      }
    ],
    "configuration": {
      "title": "AI 辅助测试",
      "properties": {
        "aitest.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "已安装 aitest 的 Python 3.11+ 解释器路径。留空时依次尝试工作区 `.venv`、`py -3`、PATH 中的 `python`；都没有时会自动准备便携运行时（下载到 `%APPDATA%/aitest/runtime/<版本>/` 并用 VSIX 自带 wheel 离线安装）。"
        },
        "aitest.workspacePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "**用户数据工作空间**目录（AI 测试记录、证据与报告所在位置），不是被打开的源码目录。CLI 通过 `--workspace` 使用该目录。"
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "build:wheel": "node scripts/build-wheel.mjs",
    "build": "npm run check && npm run build:wheel && node scripts/build.mjs",
    "package": "npm run build && vsce package --allow-missing-repository --skip-license --out dist/aitest-trae.vsix",
    "verify:vsix": "python ../../scripts/verify_vsix.py",
    "test": "node --test tests/*.test.mjs",
    "build:panel": "node scripts/build-panel.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ymyymy27/ai-test-component.git"
  }
}
