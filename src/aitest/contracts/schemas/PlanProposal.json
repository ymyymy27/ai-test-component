{
  "$defs": {
    "ProposalCase": {
      "additionalProperties": false,
      "description": "One case drafted from a template item or added by AI/user.",
      "properties": {
        "case_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "template_item_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Template Item Id"
        },
        "origin": {
          "default": "template",
          "enum": [
            "template",
            "ai",
            "user"
          ],
          "title": "Origin",
          "type": "string"
        },
        "layer": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ],
          "title": "Layer",
          "type": "string"
        },
        "objective": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Preconditions",
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "expected": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        },
        "verification_method": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Verification Method",
          "type": "string"
        },
        "links": {
          "$ref": "#/$defs/ProposalCaseLink"
        },
        "assertion_basis_text": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Assertion Basis Text",
          "type": "string"
        },
        "expected_facts": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Facts"
        },
        "independent_verification": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Independent Verification",
          "type": "string"
        },
        "mock_scope": {
          "items": {
            "type": "string"
          },
          "title": "Mock Scope",
          "type": "array"
        },
        "importance": {
          "default": "P1",
          "enum": [
            "P0",
            "P1",
            "P2"
          ],
          "title": "Importance",
          "type": "string"
        },
        "data_mutation_units": {
          "default": 1,
          "minimum": 0,
          "title": "Data Mutation Units",
          "type": "integer"
        }
      },
      "required": [
        "case_id",
        "layer",
        "objective",
        "preconditions",
        "steps",
        "expected",
        "verification_method",
        "links",
        "assertion_basis_text",
        "independent_verification"
      ],
      "title": "ProposalCase",
      "type": "object"
    },
    "ProposalCaseLink": {
      "additionalProperties": false,
      "description": "Links proposed by the model; the server injects the environment.",
      "properties": {
        "acceptance_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Acceptance Item Ids",
          "type": "array"
        },
        "module_ids": {
          "items": {
            "type": "string"
          },
          "title": "Module Ids",
          "type": "array"
        },
        "critical_path_ids": {
          "items": {
            "type": "string"
          },
          "title": "Critical Path Ids",
          "type": "array"
        },
        "no_critical_path_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "No Critical Path Reason"
        }
      },
      "title": "ProposalCaseLink",
      "type": "object"
    },
    "ProposalCoverageClaim": {
      "additionalProperties": false,
      "description": "One model-proposed ``intent × function × dimension`` claim.\n\nOnly the linkage is model content.  `claim_id`, `status`, `plan_revision`,\nevidence and verification references are server-owned and therefore\nforbidden here (`extra=\"forbid\"`), so a model cannot claim coverage proof.",
      "properties": {
        "intent_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Intent Id",
          "type": "string"
        },
        "function_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Function Id",
          "type": "string"
        },
        "dimension": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Case Ids",
          "type": "array"
        }
      },
      "required": [
        "intent_id",
        "function_id",
        "dimension",
        "case_ids"
      ],
      "title": "ProposalCoverageClaim",
      "type": "object"
    },
    "ProposalScope": {
      "additionalProperties": false,
      "description": "Acceptance scope content the model may propose.",
      "properties": {
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "objective": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "required_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Required Case Ids",
          "type": "array"
        },
        "excluded_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Case Ids",
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Exclusion Reasons",
          "type": "array"
        },
        "dependency_closure_ids": {
          "items": {
            "type": "string"
          },
          "title": "Dependency Closure Ids",
          "type": "array"
        },
        "applicability_exclusions": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Applicability Exclusions",
          "type": "array"
        }
      },
      "required": [
        "name",
        "objective"
      ],
      "title": "ProposalScope",
      "type": "object"
    },
    "ProposalTemplateDisposition": {
      "additionalProperties": false,
      "description": "Template item judged on two independent axes (design 03 §5.2).",
      "properties": {
        "template_item_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Template Item Id",
          "type": "string"
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable",
            "unknown"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "coverage": {
          "enum": [
            "covered",
            "uncovered",
            "deferred"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "template_item_id",
        "applicability",
        "coverage"
      ],
      "title": "ProposalTemplateDisposition",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A complete, editable plan proposal.  Never a published plan.",
  "properties": {
    "schema_version": {
      "default": "aitest.plan-proposal/1.0",
      "enum": [
        "aitest.plan-proposal/1.0",
        "aitest.plan-proposal/1.1"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "template_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Template Id",
      "type": "string"
    },
    "template_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Template Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ProposalScope"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/ProposalCase"
      },
      "minItems": 1,
      "title": "Cases",
      "type": "array"
    },
    "understanding_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Understanding Revision"
    },
    "goal_intent_ids": {
      "items": {
        "type": "string"
      },
      "title": "Goal Intent Ids",
      "type": "array"
    },
    "coverage_claims": {
      "items": {
        "$ref": "#/$defs/ProposalCoverageClaim"
      },
      "title": "Coverage Claims",
      "type": "array"
    },
    "template_dispositions": {
      "items": {
        "$ref": "#/$defs/ProposalTemplateDisposition"
      },
      "title": "Template Dispositions",
      "type": "array"
    }
  },
  "required": [
    "template_id",
    "template_version",
    "scope",
    "cases"
  ],
  "title": "PlanProposal",
  "type": "object"
}
