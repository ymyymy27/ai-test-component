{
  "$defs": {
    "ErrorCode": {
      "enum": [
        "OK",
        "INVALID_PROTOCOL",
        "INVALID_REQUEST",
        "REQUEST_CONFLICT",
        "AWAITING_USER_CONFIRMATION",
        "WORKSPACE_NOT_FOUND",
        "WORKSPACE_IDENTITY_MISMATCH",
        "WORKSPACE_IN_USE",
        "TRANSACTION_NOT_FOUND",
        "TRANSACTION_CONFLICT",
        "INVALID_TRANSACTION_STATE",
        "INTENT_CONFLICT",
        "RECORD_NOT_FOUND",
        "RECORD_REVISION_CONFLICT",
        "IMMUTABLE_RECORD_CONFLICT",
        "OBJECT_NOT_FOUND",
        "OBJECT_DIGEST_MISMATCH",
        "INDEX_REBUILD_REQUIRED",
        "INTEGRITY_CHECK_FAILED",
        "STORAGE_NOT_WRITABLE",
        "ATOMIC_PUBLISH_FAILED",
        "BACKUP_FAILED",
        "MIGRATION_FAILED",
        "RECOVERY_REQUIRED",
        "CAPABILITY_UNAVAILABLE",
        "CONNECTIVITY_FAILED",
        "INTERNAL_ERROR",
        "invalid_cursor",
        "maintenance_required"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "ErrorDTO": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "aitest.error/2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "next_step": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Next Step",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "intent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent Id"
        }
      },
      "required": [
        "code",
        "message",
        "next_step"
      ],
      "title": "ErrorDTO",
      "type": "object"
    },
    "JsonValue": {},
    "PageInfo": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "maximum": 500,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Cursor"
        },
        "index_state": {
          "default": "maintained",
          "title": "Index State",
          "type": "string"
        }
      },
      "required": [
        "limit"
      ],
      "title": "PageInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Unique protocol response shared by LocalAPI, ports and generated schemas.",
  "properties": {
    "protocol_version": {
      "const": "aitest.local/2.0",
      "default": "aitest.local/2.0",
      "title": "Protocol Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "instance_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Instance Id",
      "type": "string"
    },
    "workspace_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace Id"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Project Id"
    },
    "intent_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Id"
    },
    "binding_revision": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Binding Revision"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "page": {
      "anyOf": [
        {
          "$ref": "#/$defs/PageInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorDTO"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "request_id",
    "instance_id"
  ],
  "title": "Response",
  "type": "object"
}
