          "minLength": 1,
          "title": "Registered Entry",
          "type": "string"
        },
        "entry_arguments": {
          "items": {
            "type": "string"
          },
          "title": "Entry Arguments",
          "type": "array"
        },
        "cwd_mapping": {
          "minLength": 1,
