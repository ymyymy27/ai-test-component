        "basis_revision": {
          "minimum": 1,
          "title": "Basis Revision",
          "type": "integer"
        },
        "basis_text_digest": {
          "minLength": 1,
          "title": "Basis Text Digest",
          "type": "string"
        },
        "assertion_basis_state": {
          "$ref": "#/$defs/AssertionBasisStateFact"
        },
